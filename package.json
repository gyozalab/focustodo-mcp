{
  "name": "focustodo-mcp",
  "version": "2.0.0",
  "description": "MCP Server for Focus To-Do (專注清單)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "selftest": "tsc && tsx --env-file=.env src/selftest.ts",
    "update": "git pull --ff-only && npm ci --no-audit --no-fund && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.12"
  }
}
